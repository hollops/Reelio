# Copy this file to .env and adjust for your machine.
# Only variables starting with VITE_ are exposed to the browser — never put secrets here.
# Restart `npm run dev` after changing this file.

# true  = use the in-browser mock API (no backend needed) — the default if unset
# false = send real HTTP requests to VITE_API_BASE_URL
VITE_USE_MOCK_API=true

# Where the backend API lives (no trailing slash). Ignored while the mock is on.
VITE_API_BASE_URL=http://localhost:5000/api
